begin model
begin parameters###
b0__FREE 0.07988882729450134
b1__FREE 0.996783872362039
b2__FREE 0.6373922762196708
b3__FREE 1.189295560625149
gamma__FREE 0.5803691309287242
mult__FREE 6619.572640526322
r__FREE 20.17275924639695
t0__FREE 0.009425899556212338
t1__FREE 12.509420611790542
t2__FREE 16.130563608376917
t3__FREE 2.2086837044073837

###-adjustable parameter values-###
b0 b0__FREE # beta for first period (t0)
t0 t0__FREE # initial start (in weeks) for b0
#bp bp__FREE # predicted beta for 4-week forecast
#b1 b1__FREE # beta for second period (t1)
#t1 t1__FREE # second "start" for next beta phase (b1)
mult mult__FREE # dimensionless scaler to real data
gamma gamma__FREE # removal
r r__FREE #sampling parameter for AMCMC

###-settings for fixed parameter values-###
I0 5.911678927555184121e-02 # initial population scaled 0 < I0 < 1

b1 b1__FREE
t1 t1__FREE
b2 b2__FREE
t2 t2__FREE
b3 b3__FREE
t3 t3__FREE
end parameters###

begin molecule types###

S() # (number of susceptible persons)/(initial number of susceptible persons)
I() # (number of infected persons)/(initial number of susceptible persons)
R()
counter()

end molecule types###

begin seed species###
S() 1
I() I0
R() 0
end seed species
begin observables
Molecules S S()
Molecules I I()
Molecules R R()
Molecules t counter()

end observables###

begin functions###

###-time-dependent beta (piecewise)-###
beta()=if(t>=t0 && t<t0+t1,b0,\
if(t>=t0+t1 && t<t0+t1+t2,b1,\
if(t>=t0+t1+t2 && t<t0+t1+t2+t3,b2,\
if(t>=t0+t1+t2+t3,b3,\
0))))


###-NEW weekly hospitalizations-###
H_weekly()=I*S*mult*beta()

end functions###

begin reaction rules###

# timer
0->counter() 1
# infection
S()+I()->I()+I() beta()
# removal
I()->R() gamma

end reaction rules###

end model

begin actions

generate_network({overwrite=>1})

simulate({suffix=>"32",method=>"ode",t_start=>0,t_end=>36,n_steps=>36,print_functions=>1})

end actions
